# テスト用 DB の接続先。.env.test にコピーして値を入れる（vitest.config.ts と npm run db:roles:test・db:migrate:test が読む）
# CI では .github/workflows/ci.yml の env から .env.test を作る
# パスワードに記号があるときは URL エンコードする（.env.example 参照）
# ロールと DB を作る superuser（db:roles:test だけが使う。テスト用 DB を ol_migrator の持ち物として作り直す）
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# マイグレーション・テストの後始末・性能用データ（ol_migrator。全員の行に効く）。DB 名は _test で終わる
# マイグレーションテストが <DB 名>_migrations を DROP / CREATE する（ol_migrator の CREATEDB）
DATABASE_URL=postgres://ol_migrator:ol_migrator@localhost:5432/optionlist_test?sslmode=disable
# アプリとしてのテストは本番と同じ ol_app で接続する（testing.md §0）
APP_DATABASE_URL=postgres://ol_app:ol_app@localhost:5432/optionlist_test?sslmode=disable
IP_HASH_SECRET=test-ip-hash-secret
# GcsPhotoFiles のテスト（tests/api/photo-files-contract.test.ts）がつなぐ fake-gcs-server。npm --prefix backend run gcs:emulator で起動する
# 書かなければ手元では GCS の分を飛ばす（CI では飛ばさず失敗にする。docs/decisions/0051）。書いたらエミュレーターを起動してから流す
# GCS_EMULATOR_URL=http://localhost:4443
