{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --max-semi-space-size=4 src/server.ts",
    "start": "tsx --env-file=.env --max-semi-space-size=4 src/server.ts",
    "db:roles": "tsx --env-file=.env db/roles/setup-roles.ts",
    "db:roles:test": "tsx --env-file=.env.test db/roles/setup-roles.ts --test --recreate",
    "db:roles:cloud": "tsx db/roles/setup-roles.ts --cloud",
    "db:migrate": "dbmate up",
    "db:migrate:test": "dbmate --env-file .env.test --no-dump-schema up",
    "db:new": "dbmate new",
    "gcs:emulator": "docker run -d --rm --name optionlist-fake-gcs -p 4443:4443 fsouza/fake-gcs-server:1.52.2 -scheme http -backend memory -public-host localhost:4443",
    "db:perf-data": "tsx --env-file=.env.test db/perf-data/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run -s db:roles:test && npm run -s db:migrate:test && vitest run",
    "test:file": "vitest run",
    "test:coverage": "npm run -s db:roles:test && npm run -s db:migrate:test && vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/all/results.json",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:migrations": "vitest run tests/migrations --reporter=default --reporter=json --outputFile.json=coverage/migrations/results.json",
    "test:perf": "npm run -s db:roles:test && npm run -s db:migrate:test && npm run -s db:perf-data && vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dbmate": "^2.37.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
