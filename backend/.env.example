PORT=8000
# 接続先は postgres://ユーザー:パスワード@ホスト:ポート/DB 名。ロールは data.md §4
# パスワードに @ : / # % などの記号があるときは URL エンコードする（例: p@ss → p%40ss）
# 手元の PostgreSQL 17 は SSL を使わないので sslmode=disable（dbmate は付けないと SSL でつなごうとして失敗する）
# ロールと DB を作る superuser（npm --prefix backend run db:roles だけが使う）
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# マイグレーション（dbmate）。ol_migrator は表の持ち主で、db:roles がこのパスワードで作る
DATABASE_URL=postgres://ol_migrator:ol_migrator@localhost:5432/optionlist?sslmode=disable
# アプリ。ol_app は RLS を受ける（自分の行しか読み書きできない）。DB は DATABASE_URL と同じにする
APP_DATABASE_URL=postgres://ol_app:ol_app@localhost:5432/optionlist?sslmode=disable
# 削除のジョブ（npm --prefix backend run cleanup。data.md §5）。ol_cleanup は SELECT・DELETE だけができる。db:roles がこのパスワードで作る
CLEANUP_DATABASE_URL=postgres://ol_cleanup:ol_cleanup@localhost:5432/optionlist?sslmode=disable
# IP アドレスを HMAC する秘密の値（api.md §6）。手元は適当な長い文字列でよい
IP_HASH_SECRET=change-me-local-ip-hash-secret
# /api/metrics のトークン（Authorization: Bearer <トークン>）。書かなければ /api/metrics はいつも 404
# METRICS_TOKEN=change-me-local-metrics-token
# 手元は APP_ENV・APP_ORIGIN を書かない（development。Origin はリクエストの Host と比べる。docs/decisions/0050）
# 確認用・本番は APP_ENV=staging|production と APP_ORIGIN・METRICS_TOKEN・IP_HASH_SECRET・PHOTO_BUCKET が必須（ないと起動しない）
# 達成の写真の保存先（backend のフォルダから見た場所。書かなければ uploads）
# UPLOAD_DIR=uploads
# 写真を Cloud Storage の入れ物に置くとき（確認用・本番）。書かなければ UPLOAD_DIR のフォルダに置く（api.md §5）
# 手元で fake-gcs-server（npm --prefix backend run gcs:emulator）に置くなら GCS_EMULATOR_URL も書き、入れ物を先に作っておく
# （STORAGE_EMULATOR_HOST は書かない。@google-cloud/storage がそのまま読み、JSON API とアップロードの URL がずれる。docs/decisions/0051）
# PHOTO_BUCKET=optionlist-local-photos
# GCS_EMULATOR_URL=http://localhost:4443
